# Resend API key used by the contact form route handler (app/api/contact/route.ts).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender address. Must be on a domain verified in Resend.
# Without it, Resend's test sender (onboarding@resend.dev) is used, which can
# only deliver to the email address of your own Resend account.
CONTACT_FROM_EMAIL=

# Public URL of the deployed site (used for metadata, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
